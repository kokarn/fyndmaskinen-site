{
  "name": "fyndmaskinen-site",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "portless fyndmaskinen react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "pretest": "eslint src/**/*.js --fix --max-warnings 0",
    "postbuild": "node ./scripts/postbuild.js",
    "dev": "portless fyndmaskinen react-scripts start",
    "test": "react-scripts test",
    "analyze": "npm run build -- --stats && npx webpack-bundle-analyzer ./build/bundle-stats.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth0/auth0-react": "^2.22.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ericblade/quagga2": "^1.12.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "^6.0.0-beta.30",
    "@mui/material": "^6.5.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "baseline-browser-mapping": "^2.11.3",
    "caniuse-lite": "^1.0.30001806",
    "html5-qrcode": "^2.3.8",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-countdown-now": "^2.1.0",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-query": "^3.34.19",
    "react-router-dom": "^6.30.4",
    "react-scripts": "^5.0.0",
    "web-vitals": "^6.0.0",
    "workbox-background-sync": "^6.5.3",
    "workbox-broadcast-update": "^6.5.3",
    "workbox-cacheable-response": "^6.5.3",
    "workbox-core": "^6.5.3",
    "workbox-expiration": "^6.5.3",
    "workbox-google-analytics": "^6.5.3",
    "workbox-navigation-preload": "^6.5.3",
    "workbox-precaching": "^6.5.3",
    "workbox-range-requests": "^6.5.3",
    "workbox-routing": "^6.5.3",
    "workbox-strategies": "^6.5.3",
    "workbox-streams": "^6.5.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/react": "^19.2.17",
    "dotenv": "^17.4.2",
    "eslint": "^8.12.0",
    "eslint-config-kokarn": "^5.0.0",
    "portless": "^0.13.0",
    "typescript": "^4.9.5",
    "webpack-cli": "^4.10.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "eslintConfig": {
    "env": {
      "jest": true
    },
    "ignorePatterns": [
      "node_modules/**/*.js",
      "src/App.test.js",
      "src/service-worker.js",
      "src/countown-renderer.js",
      "src/Live.js",
      "src/LiveAuction.js",
      "src/LiveItem.js"
    ],
    "extends": [
      "kokarn/react",
      "plugin:react/jsx-runtime"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "rules": {
      "react/jsx-closing-bracket-location": [
        1,
        "line-aligned"
      ],
      "react/jsx-closing-tag-location": [
        1
      ],
      "react/jsx-sort-props": [
        1
      ],
      "react/jsx-no-bind": [
        1,
        {
          "ignoreDOMComponents": true
        }
      ],
      "no-unused-vars": [
        1
      ],
      "comma-dangle": [
        1
      ],
      "arrow-body-style": [
        1
      ],
      "id-blacklist": [
        1
      ],
      "no-process-env": [
        1
      ]
    }
  },
  "engines": {
    "node": "^20.0.0"
  }
}
